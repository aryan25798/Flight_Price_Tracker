# ============================================================================
# NEXT.JS / VERCEL ENVIRONMENT VARIABLES
# ============================================================================
# Public (safe for browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://<YOUR_PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY>
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=<YOUR_BOT_USERNAME_WITHOUT_AT>

# Server-only (Next.js Server Components / Server Actions — NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_OR_SECRET_KEY>

# Custom SMTP Email Server (Gmail, Brevo, SendGrid, Amazon SES, or custom domain mail)
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your@gmail.com, SMTP_PASS=your-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AeroDrop Flight Tracker" <your@gmail.com>

# ============================================================================
# SUPABASE EDGE FUNCTION SECRETS (Set via `supabase secrets set`, NOT Vercel)
# ============================================================================
# Note: SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected by Supabase Edge Runtime.
TRAVELPAYOUTS_API_TOKEN=<YOUR_TRAVELPAYOUTS_API_TOKEN>
TRAVELPAYOUTS_MARKER=<YOUR_TRAVELPAYOUTS_PARTNER_MARKER>
TELEGRAM_BOT_TOKEN=<YOUR_TELEGRAM_BOT_TOKEN>
TELEGRAM_BOT_USERNAME=<YOUR_BOT_USERNAME_WITHOUT_AT>
TELEGRAM_WEBHOOK_SECRET=<STRONG_RANDOM_WEBHOOK_SECRET>
CRON_SECRET=<SAME_CRON_SECRET_STORED_IN_SUPABASE_VAULT>
